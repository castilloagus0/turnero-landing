---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/main-sections.css';
import HeroSection from '../components/hero/Hero.astro';
import EcosystemSection from '../components/ecosystem/EcosystemSection.astro';
import BusinessImpactShowcase from '../components/product-showcase/BusinessImpactShowcase.astro';
import SolutionSection from '../components/sections/SolutionSection.astro';
import IndustriesSection from '../components/sections/IndustriesSection.astro';
import HowItWorksSection from '../components/sections/HowItWorksSection.astro';
import TrustSection from '../components/sections/TrustSection.astro';
import DemoSection from '../components/sections/DemoSection.astro';
import ReviewsSection from '../components/sections/ReviewsSection.astro';
---
<BaseLayout title="Turnate — Gestión de turnos online para tu negocio" description="Gestioná reservas online, agenda y recordatorios por WhatsApp y email desde un solo lugar. Turnate simplifica los turnos de negocios y profesionales.">
  <HeroSection />
  <BusinessImpactShowcase />
  <EcosystemSection />
  <div class="main-sections">
    <TrustSection />
    <SolutionSection />
    <IndustriesSection />
    <HowItWorksSection />
    <ReviewsSection />
    <DemoSection />
  </div>
</BaseLayout>
