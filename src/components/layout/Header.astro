---
import MobileMenu from '../islands/MobileMenu';
import Button from '../ui/Button.astro';
---
<header class="site-header" data-header><nav class="container nav" aria-label="Navegación principal"><a class="brand" href="#inicio" aria-label="Ordina, inicio">Ordina</a><div class="nav-links"><a href="#funciones">Funciones</a><a href="#rubros">Rubros</a><a href="#como-funciona">Cómo funciona</a></div><Button href="#demo" class="nav-action" variant="light">Solicitar una demo</Button><MobileMenu client:load /></nav></header>
<style is:global>.mobile-panel{position:fixed;inset:0;z-index:30;background:var(--paper);color:var(--ink);padding:28px 20px;display:flex;flex-direction:column;animation:menu-in .24s ease-out}.mobile-close{align-self:flex-end;border:0;background:transparent;color:var(--ink);padding:8px}.mobile-brand{position:absolute;top:30px;left:20px;font:34px var(--display);letter-spacing:-.07em}.mobile-panel nav{display:grid;gap:4px;margin:auto 0}.mobile-panel nav a{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:19px 0;font:42px var(--display);letter-spacing:-.04em}.mobile-cta{width:100%;margin-top:20px}@keyframes menu-in{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0)}}@media(min-width:851px){.mobile-panel{display:none}}</style>
