---
import SectionEyebrow from '../ui/SectionEyebrow.astro';
import IndustriesCarousel from '../islands/IndustriesCarousel';
import { industries } from '../../data/industries';
---
<section class="industries-motion" id="rubros" data-horizontal-section>
  <div class="industries-desktop" aria-label="Rubros que usan Ordina">
    <div class="container industries-motion__head"><SectionEyebrow>Para cada forma de trabajar</SectionEyebrow><div><h2 class="display industries-title" data-split>Una agenda.<br/>Mil formas de usarla.</h2><p class="industries-intro">El mismo sistema, pensado para respetar el ritmo particular de cada negocio.</p></div></div>
    <div class="industries-motion__viewport" data-horizontal-viewport><div class="industries-motion__track" data-horizontal-track>{industries.map((industry) => <article class="industry-panel" data-horizontal-panel><div class="industry-panel__visual" aria-hidden="true"></div><div class="industry-panel__inner"><span class="industry-number">{industry.id} / RUBRO</span><h3 class="display">{industry.name}</h3><p>{industry.description}</p><span class="industry-panel__detail">ORDINA / AGENDA HECHA A MEDIDA</span></div></article>)}</div></div>
    <div class="container industries-motion__footer"><p><span data-horizontal-current>01</span> / {String(industries.length).padStart(2, '0')}</p><div class="horizontal-progress"><i data-horizontal-progress></i></div><span>SCROLL PARA EXPLORAR</span></div>
  </div>
  <div class="industries-mobile section"><div class="container industries-head"><div><SectionEyebrow>Para cada forma de trabajar</SectionEyebrow></div><div><h2 class="display industries-title">Una agenda.<br/>Mil formas de usarla.</h2><p class="industries-intro">El mismo sistema, pensado para respetar el ritmo particular de cada negocio.</p></div></div><div class="industry-wrap"><IndustriesCarousel client:visible /></div></div>
</section>
