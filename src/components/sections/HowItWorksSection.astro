---
import SectionEyebrow from '../ui/SectionEyebrow.astro';

const steps = [
  ['01', 'Conocé el sistema.', 'En una demo breve vemos cómo Turnate puede acompañar la forma en que ya trabajás.'],
  ['02', 'Configurá tu negocio.', 'Definí servicios, profesionales y horarios disponibles con acompañamiento.'],
  ['03', 'Empezá a recibir reservas.', 'Compartí tu agenda y gestioná cada turno desde un solo lugar.'],
];
---

<section class="section steps" id="como-funciona" data-steps-section>
  <div class="container steps-layout">
    <div class="steps-intro">
      <div class="steps-head">
        <SectionEyebrow>Cómo funciona</SectionEyebrow>
        <h2 class="display steps-title" data-split>Empezar es más simple<br /><em>de lo que imaginás.</em></h2>
      </div>
      <a class="steps-cta" href="#demo">Solicitar demo <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="steps-track">
      {steps.map(([number, title, text]) => (
        <li class="step" data-step>
          <span class="step-number" aria-hidden="true">{number}</span>
          <div class="step-copy">
            <p class="step-kicker">Paso {number}</p>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
