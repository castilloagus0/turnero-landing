---
import Button from '../ui/Button.astro';
import SectionEyebrow from '../ui/SectionEyebrow.astro';
const included = ['Demo personalizada para entender tu operación.', 'Configuración guiada de servicios, equipo y horarios.', 'Acompañamiento durante la puesta en marcha.', 'Un espacio para resolver dudas antes de empezar.'];
---
<section class="section offer"><div class="container offer-layout"><div><SectionEyebrow>Una propuesta simple</SectionEyebrow><h2 class="display offer-title" data-split>Todo para empezar<br/>con claridad.</h2><p class="offer-intro">Todavía no necesitás decidir un plan. Primero queremos mostrarte qué puede resolver Ordina en tu negocio.</p><Button href="#demo" variant="dark" magnetic>Solicitar una demo</Button></div><div class="offer-list" data-reveal><p class="offer-label">¿QUÉ INCLUYE?</p>{included.map((item, index) => <div><span>0{index + 1}</span><p>{item}</p></div>)}</div></div></section>
