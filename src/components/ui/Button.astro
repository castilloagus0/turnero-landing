---
interface Props { href?: string; variant?: 'dark' | 'light' | 'line'; class?: string; type?: 'button' | 'submit'; magnetic?: boolean; }
const { href, variant = 'dark', class: className = '', type = 'button', magnetic = false } = Astro.props;
const classes = `button button--${variant} ${className}`;
---
{href ? <a href={href} class={classes} data-magnetic={magnetic ? '' : undefined}><slot /><span class="arrow" aria-hidden="true">→</span></a> : <button type={type} class={classes} data-magnetic={magnetic ? '' : undefined}><slot /><span class="arrow" aria-hidden="true">→</span></button>}
