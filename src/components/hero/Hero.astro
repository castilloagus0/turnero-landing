---
import HeroContent from './HeroContent.astro';
import earthPoster from '../../assets/images/turnate-earth-hero.png';
---
<section class="hero" id="inicio" data-hero style={`--hero-poster: url('${earthPoster.src}')`}>
  <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={earthPoster.src} aria-hidden="true" data-hero-video>
    <source src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260613_180732_a54afbf6-b30d-470e-861f-669871f09f67.mp4" type="video/mp4" />
  </video>
  <div class="hero-overlay" aria-hidden="true"></div>
  <HeroContent />
  <div class="hero-indicator" aria-hidden="true"><span></span><p>Experiencia<br />en movimiento</p></div>
</section>
